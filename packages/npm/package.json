{
  "name": "@zakadi/protocol",
  "version": "0.0.1",
  "description": "Shared protocol types and constants for the Zakadi face-liveness SDKs (zakadi.v1): session states, error codes, terminal states, close codes, challenge kinds.",
  "keywords": [
    "zakadi",
    "liveness",
    "biometrics",
    "identity-verification",
    "protocol"
  ],
  "homepage": "https://zakadi.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakadihq/zakadi-protocol.git",
    "directory": "packages/npm"
  },
  "bugs": "https://github.com/zakadihq/zakadi-protocol/issues",
  "license": "Apache-2.0",
  "author": "Moses Gameli",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
