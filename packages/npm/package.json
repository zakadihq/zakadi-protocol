{
  "name": "@zakadi/protocol",
  "version": "0.0.1",
  "description": "The Zakadi wire protocol (zakadi.v1) for the face-liveness SDKs: JSON Schemas, message types, standalone validators, conformance vectors and shared constants.",
  "keywords": [
    "zakadi",
    "liveness",
    "biometrics",
    "identity-verification",
    "protocol"
  ],
  "homepage": "https://zakadi.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakadihq/zakadi-protocol.git",
    "directory": "packages/npm"
  },
  "bugs": "https://github.com/zakadihq/zakadi-protocol/issues",
  "license": "Apache-2.0",
  "author": "Moses Gameli",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors": {
      "types": "./dist/vectors.d.ts",
      "node": "./dist/vectors.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "vectors",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "test": "npm run sync && npm run build && node --test",
    "prepublishOnly": "npm test",
    "format": "prettier --check .",
    "lint": "npm run generate && eslint . && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1"
  }
}
