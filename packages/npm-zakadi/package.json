{
  "name": "zakadi",
  "version": "0.1.0",
  "description": "Zakadi face liveness: name-holding package with the shared protocol constants (zakadi.v1). The SDKs are published under @zakadi/*.",
  "keywords": [
    "zakadi",
    "liveness",
    "biometrics",
    "identity-verification",
    "protocol"
  ],
  "homepage": "https://zakadi.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakadihq/zakadi-protocol.git",
    "directory": "packages/npm-zakadi"
  },
  "bugs": "https://github.com/zakadihq/zakadi-protocol/issues",
  "license": "Apache-2.0",
  "author": "Moses Gameli",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test",
    "format": "prettier --check .",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1"
  }
}
