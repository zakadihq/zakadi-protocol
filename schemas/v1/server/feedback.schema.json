{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zakadi.dev/schemas/v1/server/feedback.schema.json",
  "title": "zakadi.v1 server-to-client message `feedback`",
  "description": "Informational quality feedback.",
  "type": "object",
  "properties": {
    "t": {
      "const": "feedback"
    },
    "id": {
      "$ref": "https://zakadi.dev/schemas/v1/common.schema.json#/$defs/id"
    },
    "code": {
      "$ref": "https://zakadi.dev/schemas/v1/common.schema.json#/$defs/feedbackCode"
    },
    "severity": {
      "enum": [
        "hint",
        "block"
      ]
    }
  },
  "required": [
    "t",
    "code",
    "severity"
  ]
}
